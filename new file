elif page == "Pre-Processing":

    st.title("🧹 Data Preprocessing")

    # Create 3 tabs
    tab1, tab2, tab3 = st.tabs([
        "🗂️ Original Data",
        "🧹 Cleaned Data",
        "📥 Download & Summary"
    ])

    # =====================================================
    # TAB 1 — ORIGINAL DATA
    # =====================================================
    with tab1:

        st.subheader("📋 Original Dataset")

        st.dataframe(
            df,
            use_container_width=True
        )

        col1, col2 = st.columns(2)

        with col1:
            st.metric(
                "📄 Original Rows",
                df.shape[0]
            )

        with col2:
            st.metric(
                "📑 Original Columns",
                df.shape[1]
            )

    # =====================================================
    # TAB 2 — CLEANED DATA
    # =====================================================
    with tab2:

        st.subheader("🧹 Cleaned Dataset")

        # Load dataset
        clean_df = pd.read_csv("Cleaned_dataset.csv")

        # Remove duplicate rows
        clean_df = clean_df.drop_duplicates()

        # Convert Date column
        if "Date" in clean_df.columns:
            clean_df["Date"] = pd.to_datetime(
                clean_df["Date"],
                errors="coerce"
            )

        # Convert numeric columns
        numeric_cols = [
            "Current_Price_INR",
            "Launch_Price_USD",
            "Rating",
            "Reviews_Count"
        ]

        for col in numeric_cols:
            if col in clean_df.columns:
                clean_df[col] = pd.to_numeric(
                    clean_df[col],
                    errors="coerce"
                )

        # Remove missing values
        clean_df = clean_df.dropna()

        # Display cleaned data
        st.dataframe(
            clean_df,
            use_container_width=True
        )

        # Dataset information
        st.subheader("📊 Dataset Information")

        col1, col2 = st.columns(2)

        with col1:
            st.metric(
                "📄 Total Rows",
                clean_df.shape[0]
            )

        with col2:
            st.metric(
                "📑 Total Columns",
                clean_df.shape[1]
            )

    # =====================================================
    # TAB 3 — SUMMARY & DOWNLOAD
    # =====================================================
    with tab3:

        st.subheader("❗ Missing Values")

        missing_values = (
            clean_df.isnull()
            .sum()
            .reset_index()
            .rename(
                columns={
                    "index": "Column",
                    0: "Missing Values"
                }
            )
        )

        st.dataframe(
            missing_values,
            use_container_width=True
        )

        st.subheader("🔤 Data Types")

        data_types = (
            clean_df.dtypes
            .reset_index()
            .rename(
                columns={
                    "index": "Column",
                    0: "Data Type"
                }
            )
        )

        st.dataframe(
            data_types,
            use_container_width=True
        )

        # Download cleaned dataset
        csv = clean_df.to_csv(
            index=False
        ).encode("utf-8")

        st.download_button(
            label="📥 Download Cleaned Dataset",
            data=csv,
            file_name="cleaned_dataset.csv",
            mime="text/csv"
        )


